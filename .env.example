ANTHROPIC_API_KEY=<your-key>
# RUNNER=stub|api|cli  (default: api when a key is set, else your logged-in Claude Code account, else stub)
# MODEL=claude-opus-5-5
# CLI_MODEL=opus
# DATABASE_URL=sqlite:///data/workbench.db

# ETL Crew hand-off (Jira). Bearer form:
JIRA_BASE_URL=https://api.atlassian.com/ex/jira/<cloud-id>
JIRA_TOKEN=<service-account-token>
JIRA_SITE_URL=https://<site>.atlassian.net
# ...or classic API token form (leave JIRA_TOKEN empty):
# JIRA_BASE_URL=https://<site>.atlassian.net
# JIRA_EMAIL=<bot@example.com>
# JIRA_API_TOKEN=<api-token>
JIRA_PROJECT_KEY=<KEY>
JIRA_LEAD_ACCOUNT_ID=<etl-crew-lead-account-id>
# JIRA_ISSUE_TYPE=Task

# ETL Crew ticket sent straight to the crew's opencode server (`opencode serve`)
OPENCODE_URL=http://127.0.0.1:4096
# OPENCODE_AGENT=lead
# OPENCODE_USERNAME=<basic-auth-user>
# OPENCODE_PASSWORD=<basic-auth-password>
# OPENCODE_PUBLIC_URL=<opencode-web-ui-url>
# OPENCODE_CA_BUNDLE=<path-to-server-cert.pem>   # trust a self-signed opencode certificate (verification stays on)
# OPENCODE_TLS_SERVER_NAME=<cert-common-name>     # when the cert's name isn't the URL host (e.g. a raw ALB DNS name)
# Reference files for {{GIT:…}} / {{NB_…}} placeholders (else the learned snapshot in data/crew-ticket/ is used):
# TICKET_REFERENCE_REPO=<path-to-local-clone>
# TICKET_REFERENCE_REF=origin/main
# TICKET_REFERENCE_NOTEBOOK=<repo-path-of-reference-notebook.ipynb>
# TICKET_S3_SQL_FILE=<local-copy-of-legacy-sql>
